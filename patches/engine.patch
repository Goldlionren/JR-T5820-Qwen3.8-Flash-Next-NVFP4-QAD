diff --git a/src/kernels/bf16_bits_cuda.cu b/src/kernels/bf16_bits_cuda.cu
new file mode 100644
index 0000000..c5aa734
--- /dev/null
+++ b/src/kernels/bf16_bits_cuda.cu
@@ -0,0 +1,33 @@
+#include "strata/kernels/kv_dtype.hpp"
+#include "bf16_reference.hpp"
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <random>
+#include <vector>
+__global__ void encode(const float* x,uint16_t* y,uint16_t* intrinsic,int n){
+    const int i=blockIdx.x*blockDim.x+threadIdx.x;if(i>=n)return;
+    y[i]=strata::kernels::kv_bf16_encode(x[i]);
+    intrinsic[i]=__bfloat16_as_ushort(__float2bfloat16_rn(x[i]));
+}
+int main(){
+    std::vector<float> x;std::mt19937 gen(5820);
+    auto add=[&](uint32_t u){float f;std::memcpy(&f,&u,4);x.push_back(f);};
+    for(unsigned h=0;h<65536;++h)for(unsigned low:{0u,0x7fffu,0x8000u,0x8001u})add((h<<16)|low);
+    for(int i=0;i<1000000;++i)add(gen());
+    float* dx=nullptr;uint16_t *dy=nullptr,*di=nullptr;
+    if(cudaMalloc(&dx,x.size()*4)!=cudaSuccess||cudaMalloc(&dy,x.size()*2)!=cudaSuccess||cudaMalloc(&di,x.size()*2)!=cudaSuccess)return 1;
+    if(cudaMemcpy(dx,x.data(),x.size()*4,cudaMemcpyHostToDevice)!=cudaSuccess)return 1;
+    encode<<<(x.size()+255)/256,256>>>(dx,dy,di,int(x.size()));
+    if(cudaDeviceSynchronize()!=cudaSuccess)return 1;
+    std::vector<uint16_t> y(x.size()),intr(x.size());
+    if(cudaMemcpy(y.data(),dy,y.size()*2,cudaMemcpyDeviceToHost)!=cudaSuccess||cudaMemcpy(intr.data(),di,intr.size()*2,cudaMemcpyDeviceToHost)!=cudaSuccess)return 1;
+    for(size_t i=0;i<x.size();++i){
+        const auto ref=bf16_test::reference(x[i]);
+        if(!bf16_test::same(y[i],ref)||!bf16_test::same(intr[i],ref)||y[i]!=strata::kernels::kv_bf16_encode(x[i])){
+            std::fprintf(stderr,"FAIL CUDA RNE i=%zu x=%.9g gpu=%04x intrinsic=%04x ref=%04x\n",i,x[i],y[i],intr[i],ref);return 1;
+        }
+    }
+    cudaFree(dx);cudaFree(dy);cudaFree(di);
+    std::printf("PASS CUDA/host bit-exact and independent arithmetic + NVIDIA RNE intrinsic: %zu cases\n",x.size());
+}
diff --git a/src/kernels/bf16_cpu_test.cpp b/src/kernels/bf16_cpu_test.cpp
new file mode 100644
index 0000000..db78019
--- /dev/null
+++ b/src/kernels/bf16_cpu_test.cpp
@@ -0,0 +1,27 @@
+#include "strata/kernels/kv_dtype.hpp"
+#include "bf16_reference.hpp"
+#include <cstdio>
+#include <random>
+#include <cstdlib>
+int main() {
+    using namespace strata::kernels;
+    unsigned long count=0;
+    auto check=[&](float f) {
+        const auto got=kv_bf16_encode(f), want=bf16_test::reference(f);
+        if(!bf16_test::same(got,want)) {std::fprintf(stderr,"RNE mismatch %.9g %04x %04x\n",f,got,want);std::exit(1);} ++count;
+    };
+    for(unsigned h=0;h<65536;++h) {
+        check(bf16_test::decode(uint16_t(h)));
+        if((h&0x7fff)<=0x7f80 && kv_bf16_encode(bf16_test::decode(uint16_t(h)))!=h) return 1;
+        for(unsigned low : {0x7fffu,0x8000u,0x8001u}) {
+            uint32_t u=(h<<16)|low; float f;std::memcpy(&f,&u,4);check(f);
+        }
+    }
+    std::mt19937 gen(5820);
+    for(int i=0;i<1000000;++i) {uint32_t u=gen();float f;std::memcpy(&f,&u,4);check(f);}
+    for(float f : {0.f,-0.f,1.f,-1.f,131072.f,1e-8f,1.00390625f,1.01171875f})
+        std::printf("bits input=%.9g cpu=%04x reference=%04x\n",f,kv_bf16_encode(f),bf16_test::reference(f));
+    KvStorage s;
+    if(!parse_kv_storage("bf16",s)||s!=KvStorage::Bf16||parse_kv_storage("BF16",s)||parse_kv_storage("garbage",s)) return 1;
+    std::printf("PASS independent arithmetic RNE: %lu cases, finite encodings exhaustive, tie neighbors exhaustive\n",count);
+}
