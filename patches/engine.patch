+        k::qsa_decode_attn_step(q,pools,di,step,cap,s,scratch,out,nullptr);ck(cudaDeviceSynchronize());need(read(out,nh*256)==replay,"graph replay attention parity");
+        auto bits=read(pv,pool_size);for(int d=0;d<256;++d)need(bits[row(w-1,0,page,table[(w-1)/page])*256+d]==bf16_test::reference(V[d]),"graph append position advances");
+    }
