--- /dev/null
+++ b/tools/test_bf16_fail_closed.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""Negative engine/kernel tests; invalid configurations must fail before reading a pack."""
+import subprocess
+import sys
+
+engine, kernels = sys.argv[1:]
+base=[engine,'--pack','/does-not-exist-bf16-negative-test','--tokens','1']
+cases=[
+    ([kernels,'--bad-dtype'],'invalid dtype/geometry/pools'),
+    ([kernels,'--bad-stream-format'],'invalid/mismatched dtype'),
+    (base+['--kv','not-a-format'],'--kv must be'),
+    (base+['--kv','bf16','--draft','auto'],'BF16 KV auto requires both'),
+    (base+['--kv','bf16','--kv-grow'],'unsupported; no fallback'),
+    (base+['--kv','bf16','--batch','2'],'unsupported; no fallback'),
+    (base+['--kv','bf16','--native-flash-attn-short'],'unsupported; no fallback'),
+]
+for cmd,message in cases:
+    p=subprocess.run(cmd,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=30)
+    print('COMMAND',cmd,'RETURN',p.returncode,flush=True)
+    print(p.stdout,flush=True)
+    assert p.returncode==2 and message in p.stdout,(p.returncode,message)
+    assert 'cannot open' not in p.stdout.lower(), 'reached model loading before config refusal'
+# A complete drafter selection passes the BF16 precision gate, then the deliberately
+# absent PLE option stops it before GPU probing or any model loading.
+p=subprocess.run(base+['--kv','bf16','--draft','auto','--mtp','/does-not-exist-mtp',
+                       '--draft-model','/does-not-exist-dflash2','--spec','8'],
+                 text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=30)
+print('POSITIVE PRECISION CONFIG RETURN',p.returncode,flush=True)
+print(p.stdout,flush=True)
+assert p.returncode==2 and 'KV precision contract: target=BF16, MTP=BF16' in p.stdout
+assert 'DFlash2 ring=FP32 (independent)' in p.stdout and '--ple-gguf is required' in p.stdout
+assert 'PCIe probe' not in p.stdout and 'cannot open' not in p.stdout.lower()
+print('PASS precision configuration, fail-closed dtype and unsupported combinations; no model was loaded')
