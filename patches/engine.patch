diff --git a/src/kernels/bf16_reference.hpp b/src/kernels/bf16_reference.hpp
new file mode 100644
index 0000000..b786aba
--- /dev/null
+++ b/src/kernels/bf16_reference.hpp
@@ -0,0 +1,38 @@
+#pragma once
+// Test oracle: arithmetic rounding, independent of the production bit-add encoder.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+namespace bf16_test {
+inline uint16_t reference(float x) {
+    const uint16_t sign=std::signbit(x)?0x8000:0;
+    if(std::isnan(x)) return sign|0x7fc0;
+    if(std::isinf(x)) return sign|0x7f80;
+    double a=std::fabs(double(x));
+    if(a==0) return sign;
+    int e=0; std::frexp(a,&e);
+    // Normal BF16 has eight significant bits; subnormals have fixed 2^-133 spacing.
+    const int power=std::max(e-8,-133);
+    const double scaled=std::ldexp(a,-power), lo=std::floor(scaled), fraction=scaled-lo;
+    const double rounded=lo+(fraction>0.5 || (fraction==0.5 && std::fmod(lo,2.0)!=0));
+    const double value=std::ldexp(rounded,power);
+    if(value>=std::ldexp(1.0,128)) return sign|0x7f80;
+    const float exact=float(value);
+    uint32_t u; std::memcpy(&u,&exact,4);
+    return sign|uint16_t(u>>16);
+}
+inline float decode(uint16_t h) {
+    const int exponent=(h>>7)&255, fraction=h&127;
+    if(exponent==255) return fraction ? std::numeric_limits<float>::quiet_NaN()
+                                      : std::copysign(INFINITY,h&0x8000?-1.f:1.f);
+    const double a=exponent ? std::ldexp(double(128+fraction),exponent-134)
+                            : std::ldexp(double(fraction),-133);
+    return std::copysign(float(a),h&0x8000?-1.f:1.f);
+}
+inline bool same(uint16_t a,uint16_t b) {
+    const bool na=(a&0x7fff)>0x7f80, nb=(b&0x7fff)>0x7f80;
+    return a==b || (na&&nb&&(a&0x40)); // quiet NaN payload may differ
+}
+}
