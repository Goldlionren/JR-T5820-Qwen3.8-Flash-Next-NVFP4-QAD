index 0000000..bf652e4
--- /dev/null
+++ b/tools/test_dflash2_bf16.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Generate a ~62 MiB sparse synthetic context-only DF2P fixture; no model assets.
+The file deliberately omits block/head tensors and cannot run draft inference.
+"""
+import hashlib
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+
+
+def fixture(path):
+    tensors = []
+    def q8(name, rows, cols):
+        data = bytearray(rows * cols // 32 * 34)
+        for r in range(rows):
+            col = (r * 19 + 11) % cols
+            off = (r * (cols // 32) + col // 32) * 34
+            struct.pack_into('<e', data, off, 0.03125)
+            data[off + 2 + col % 32] = 1 + r % 7
+        tensors.append((name, 'q8_0', rows, cols, data))
+    def norm(name, count):
+        tensors.append((name, 'f32', 1, count, struct.pack('<f', 1.) * count))
+    q8('fc.weight', 2560, 12800)
+    norm('hidden_norm.weight', 2560)
+    for layer in range(5):
+        for kind in ('k', 'v'):
+            q8(f'layers.{layer}.self_attn.{kind}_proj.weight', 1024, 2560)
+        norm(f'layers.{layer}.self_attn.k_norm.weight', 128)
+    index = 'cfg taps 5,15,25,35,45\n'
+    off = 0
+    for name, dtype, rows, cols, data in tensors:
+        index += f't {name} {dtype} {rows} {cols} {off} {len(data)}\n'
+        off += len(data)
+    index = index.encode()
+    with open(path, 'wb') as f:
+        f.write(b'DF2P' + struct.pack('<II', 1, len(index)) + index)
+        for *_, data in tensors:
+            f.write(data)
+    with path.open('rb') as fixture_file:
+        digest = hashlib.file_digest(fixture_file, 'sha256').hexdigest()
+    print(f'SYNTHETIC CONTEXT-ONLY fixture bytes={path.stat().st_size} sha256={digest}', flush=True)
+
+
+if __name__ == '__main__':
+    with tempfile.TemporaryDirectory(prefix='strata-df2-synthetic-') as td:
+        path = Path(td) / 'context-only.df2p'
+        fixture(path)
+        # Optional sanitizer prefix is passed before --binary.
+        args = sys.argv[1:]
+        split = args.index('--binary')
+        prefix, binary = args[:split], args[split + 1]
+        mode = [] if '--legacy' in args[split + 2:] else ['--bf16']
+        if '--race-smoke' in args[split + 2:]: mode.append('--race-smoke')
+        subprocess.run(prefix + [binary, str(path), '0'] + mode, check=True)
