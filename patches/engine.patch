+// Model-free state tests. These exercise the actual MTP KV primitives and stop bound,
+// not the weight-dependent MtpDrafter/Verifier inference or acceptance probabilities.
+#include "strata/core/layer.hpp"
+#include "strata/core/layout.hpp"
+#include "strata/core/serve_stop_bound.hpp"
+#include "strata/kernels/kv_bf16.hpp"
+#include "strata/kernels/verify_kernels.hpp"
+#include "bf16_reference.hpp"
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+namespace k=strata::kernels;
+namespace c=strata::core;
+void ck(cudaError_t e){if(e!=cudaSuccess){std::fprintf(stderr,"CUDA: %s\n",cudaGetErrorString(e));std::exit(1);}}
+void need(bool b,const char* s){if(!b){std::fprintf(stderr,"FAIL %s\n",s);std::exit(1);}}
+template<class T>T* alloc(size_t n){T* p=nullptr;ck(cudaMalloc(&p,n*sizeof(T)));return p;}
+int main(int argc,char** argv){
+    setenv("STRATA_KV_HOST_REGISTER", "0", 1);
+    k::configured_kv_storage=k::KvStorage::Bf16;c::qsa_set_kv_resident(32768);
+    c::ModelGeometry g;auto s=c::qsa_shapes(g);c::QsaState st;
+    const bool failure=argc>1;
+    const int cells=failure?2048:128,ring=16;
+    void* arena=alloc<uint8_t>(c::qsa_state_bytes(g,cells,true,ring));
+    const auto used=c::qsa_state_init(g,cells,arena,st,nullptr,ring);
+    auto release_host = [&] {
+        if (st.host.k_pool) ck(cudaFreeHost(st.host.k_pool));
+        if (st.host_step) ck(cudaFreeHost(st.host_step));
+        if (st.host_pos) ck(cudaFreeHost(st.host_pos));
+    };
+    if(failure){
+        need(std::getenv("STRATA_TEST_PIN_BUDGET_MIB")!=nullptr,"explicit fault-injection environment");
+        need(used==0 && st.storage==k::KvStorage::Bf16 && st.kv_mode==2 && !st.host.present(),"pin exhaustion fails closed, preserves requested BF16/ring");
+        release_host();ck(cudaFree(arena));std::puts("PASS injected pinned allocation exhaustion: no dtype or residency fallback");return 0;
+    }
+    need(used>0 && st.storage==k::KvStorage::Bf16 && st.host.storage==st.storage && c::qsa_kv_format(st)==k::kKvBf16,"engine state dtype metadata");
+    c::qsa_state_zero(st,g,nullptr);
+    float *dk=alloc<float>(512),*dv=alloc<float>(512),*q=alloc<float>(24*256),*out=alloc<float>(24*256);
+    auto ids=alloc<int32_t>(8);ck(cudaMemset(q,0,24*256*4));
+    std::vector<float> K(512),V(512);std::vector<uint16_t> expected(cells*512);
+    auto write=[&](int pos,float value){
+        std::fill(K.begin(),K.end(),0.f);std::fill(V.begin(),V.end(),value);
+        ck(cudaMemcpy(dk,K.data(),512*4,cudaMemcpyHostToDevice));ck(cudaMemcpy(dv,V.data(),512*4,cudaMemcpyHostToDevice));
+        int32_t step[4]={pos,pos+1,(pos+1)/4,1};ck(cudaMemcpy(st.step,step,sizeof(step),cudaMemcpyHostToDevice));
+        k::kv_append_step(st.k_pool,st.v_pool,st.page_table,st.step,dk,dv,s,nullptr,&st.host);
+        std::fill(expected.begin()+pos*512,expected.begin()+(pos+1)*512,bf16_test::reference(value));
+    };
+    unsigned scenarios=0;
+    for(int spec:{1,4,k::kVerifyMaxT})for(int accepted=0;accepted<=spec;++accepted)for(int stop:{0,1,2}){
+        // Start just before wrap. Draft writes ahead, then logical commit excludes rejected suffix.
+        for(int t=0;t<60;++t)write(t,float(t)*0.125f);
+        for(int t=0;t<spec;++t)write(60+t,100.f+float(t));
+        std::vector<int> outputs(spec,7);if(spec>1)outputs[1]=99;
+        const int keep=c::serve_stop_bound(accepted,stop==1?1:spec,outputs.data(),[&](int x){return stop==2&&x==99;});
+        need(keep>=0&&keep<=accepted,"bounded commit count");
+        int cursor=60+keep;
+        // Next accepted input overwrites the rejected first row with a distinct BF16 range sentinel.
+        write(cursor,131072.f);++cursor;
+        const int end=(cursor+3)/4;
+        k::kv_ring_restore(c::qsa_attn_pools(st),st.host,k::kKvBf16,std::max(0,end-4),end,4,s,nullptr);
+        std::vector<int32_t> selected(8);for(int j=0;j<8;++j)selected[j]=cursor-8+j;
+        ck(cudaMemcpy(ids,selected.data(),32,cudaMemcpyHostToDevice));
+        int32_t step[4]={cursor-1,cursor,cursor/4,8};ck(cudaMemcpy(st.step,step,16,cudaMemcpyHostToDevice));
+        k::kv_bf16_attention(q,c::qsa_attn_pools(st),ids,st.step,8,s,out,1,nullptr);ck(cudaDeviceSynchronize());
+        std::vector<float> result(24*256);ck(cudaMemcpy(result.data(),out,result.size()*4,cudaMemcpyDeviceToHost));
+        double mean=0;for(int j:selected)mean+=bf16_test::decode(expected[j*512]);mean/=8;
+        for(float v:result)need(std::fabs(v-mean)<=1e-4+2e-3*std::fabs(mean),"accepted history only after ring rollback/reload");
+        // Check ring and backing raw bits, not only the resulting attention.
+        std::vector<uint16_t> ring_bits(16*512);ck(cudaMemcpy(ring_bits.data(),st.v_pool,ring_bits.size()*2,cudaMemcpyDeviceToHost));
+        for(int pos:selected)for(int h=0;h<2;++h)for(int d=0;d<256;++d){
+            const size_t hi=((pos/4)*2+h)*4*256+(pos%4)*256+d;
+            const size_t ri=(((pos/4)%4)*2+h)*4*256+(pos%4)*256+d;
+            need(st.host.v_pool[hi]==expected[pos*512+h*256+d]&&ring_bits[ri]==expected[pos*512+h*256+d],"MTP backing/ring exact bits");
+        }
+        ++scenarios;
+    }
+    release_host();
+    for(void* p:{(void*)dk,(void*)dv,(void*)q,(void*)out,(void*)ids,arena})ck(cudaFree(p));
+    std::printf("PASS %u MTP KV mechanism scenarios: spec 1/4/%d, accept/reject/partial, EOS/output bound, ring wrap/reload; full MTP inference NOT RUN\n",scenarios,k::kVerifyMaxT);
+}
