index 0000000..9dc3b04
--- /dev/null
+++ b/src/kernels/cuda/kv_bf16.cu
@@ -0,0 +1,201 @@
+#include "strata/kernels/kv_bf16.hpp"
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <mma.h>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace strata::kernels {
+namespace {
+void validate(const float* q, const QsaAttnPools& p, const int32_t* ids,
+              const int32_t* steps, int64_t cap, const QsaShapes& s,
+              float* out, int64_t nq) {
+    if(p.storage!=KvStorage::Bf16 || s.storage!=KvStorage::Bf16 || !q || !out ||
+       !ids || !steps || !p.k_pool || !p.v_pool || !p.page_table || p.k_q || p.k_q4 ||
+       p.v_q || p.v_q4 || p.k_scale || p.v_scale || s.head_dim!=256 || s.n_head_kv<=0 || s.n_head<=0 ||
+       s.n_head%s.n_head_kv || s.page_size<=0 || cap<=0 || cap>INT32_MAX || nq<1 || nq>65535) {
+        std::fprintf(stderr,"BF16 KV: invalid dtype/geometry/pools; no FP16 fallback\n");
+        std::exit(2);
+    }
+}
+// One block/query/head, online softmax in FP32. This deliberately favors a small,
+// auditable reference path over throughput. It also handles an empty selection.
+__global__ void bf16_attention_kernel(const float* q, QsaAttnPools p, const int32_t* ids,
+                                     const int32_t* steps, int cap, int nh, int nkh,
+                                     int page_size, float* out) {
+    const int h=blockIdx.x, z=blockIdx.y, d=threadIdx.x, kh=h/(nh/nkh);
+    const int* step=steps+z*kStepCount;
+    const int width=step[kStepWidth];
+    if(width<0 || width>cap) __trap();
+    const float x=q[(size_t(z)*nh+h)*256+d];
+    float m=-INFINITY, l=0.f, a=0.f;
+    __shared__ float reduce[256];
+    for(int j=0;j<width;++j) {
+        const int cell=ids[size_t(z)*cap+j];
+        if(cell<0 || cell>=step[kStepNKv]) __trap();
+        const int page=p.page_table[cell/page_size];
+        if(page<0) __trap(); // resolver must have made every selected page resident
+        const size_t row=(size_t(page)*nkh+kh)*page_size+cell%page_size;
+        reduce[d]=x*kv_bf16_decode(p.k_pool[row*256+d]);
+        __syncthreads();
+        for(int stride=128;stride;stride>>=1) {
+            if(d<stride) reduce[d]+=reduce[d+stride];
+            __syncthreads();
+        }
+        const float score=reduce[0]*(1.f/16.f), next=fmaxf(m,score);
+        const float alpha=expf(m-next), beta=expf(score-next);
+        a=a*alpha+beta*kv_bf16_decode(p.v_pool[row*256+d]);
+        l=l*alpha+beta; m=next;
+        __syncthreads();
+    }
+    out[(size_t(z)*nh+h)*256+d]=l>0 ? a/l : 0.f;
+}
+
+// Same 256-product reduction tree and online softmax order as the reference.
+// Eight dimensions per lane remove block-wide barriers without narrowing Q or
+// changing the BF16 stored K/V. Warp shuffle scheduling follows the existing
+// CUDA QSA path; unlike chunked attention this preserves the reduction grouping.
+__global__ void bf16_attention_warp_kernel(const float* q, QsaAttnPools p, const int32_t* ids,
+                                          const int32_t* steps, int cap, int nh, int nkh,
+                                          int page_size, float* out) {
+    const int h=blockIdx.x, z=blockIdx.y, lane=threadIdx.x, kh=h/(nh/nkh);
+    const int* step=steps+z*kStepCount;
+    const int width=step[kStepWidth];
+    if(width<0 || width>cap) __trap();
+    float x[8],a[8]={0.f},m=-INFINITY,l=0.f;
+    #pragma unroll
+    for(int k=0;k<8;++k) x[k]=q[(size_t(z)*nh+h)*256+lane+32*k];
+    for(int j=0;j<width;++j) {
+        const int cell=ids[size_t(z)*cap+j];
+        if(cell<0 || cell>=step[kStepNKv]) __trap();
+        const int page=p.page_table[cell/page_size];
+        if(page<0) __trap();
+        const size_t row=(size_t(page)*nkh+kh)*page_size+cell%page_size;
+        float v[8];
+        #pragma unroll
+        for(int k=0;k<8;++k) v[k]=__fmul_rn(x[k],kv_bf16_decode(p.k_pool[row*256+lane+32*k]));
+        float sum=__fadd_rn(__fadd_rn(__fadd_rn(v[0],v[4]),__fadd_rn(v[2],v[6])),
+                            __fadd_rn(__fadd_rn(v[1],v[5]),__fadd_rn(v[3],v[7])));
+        #pragma unroll
+        for(int stride=16;stride;stride>>=1) {
+            const float other=__shfl_down_sync(0xffffffff,sum,stride);
+            if(lane<stride) sum=__fadd_rn(sum,other);
+        }
+        const float score=__shfl_sync(0xffffffff,sum,0)*(1.f/16.f),next=fmaxf(m,score);
+        const float alpha=expf(m-next),beta=expf(score-next);
+        #pragma unroll
+        for(int k=0;k<8;++k) a[k]=a[k]*alpha+beta*kv_bf16_decode(p.v_pool[row*256+lane+32*k]);
+        l=l*alpha+beta;m=next;
+    }
+    #pragma unroll
+    for(int k=0;k<8;++k) out[(size_t(z)*nh+h)*256+lane+32*k]=l>0?a[k]/l:0.f;
+}
+
+// A tile shares one KV head across its 12 query heads. Only Q is split into two
+// BF16 components; stored K/V bits are read unchanged. The residual component
+// avoids losing Q's FP32 precision to one BF16 conversion. Softmax and PV remain
+// FP32, so tiny probabilities never pass through BF16/FP16 storage.
+__global__ void bf16_attention_tc_kernel(const float* q, QsaAttnPools p, const int32_t* ids,
+                                        const int32_t* steps, int cap, int nkh, int page_size, float* out) {
+#if __CUDA_ARCH__ >= 800
+    using namespace nvcuda;
+    const int kh=blockIdx.x,z=blockIdx.y,d=threadIdx.x,nh=nkh*12;
+    const int* step=steps+z*kStepCount;
+    const int width=step[kStepWidth];
+    if(width<0 || width>cap) __trap();
+    __shared__ __align__(32) __nv_bfloat16 qhi[256],qlo[256],keys[256];
+    __shared__ __align__(32) float scores[256];
+    __shared__ int cells[16],pages[16];
+    float m[12],l[12],acc[12];
+    for(int h=0;h<12;++h){m[h]=-INFINITY;l[h]=0;acc[h]=0;}
+    for(int j0=0;j0<width;j0+=16){
+        if(d<16){
+            const int cell=j0+d<width?ids[size_t(z)*cap+j0+d]:-1;
+            if(j0+d<width && (cell<0 || cell>=step[kStepNKv])) __trap();
+            cells[d]=cell;pages[d]=cell>=0?p.page_table[cell/page_size]:-1;
+            if(cell>=0 && pages[d]<0) __trap();
+        }
+        __syncthreads();
+        wmma::fragment<wmma::accumulator,16,16,16,float> sums;
+        if(d<32) wmma::fill_fragment(sums,0.f);
+        for(int f=0;f<256;f+=16){
+            const int h=d/16,c=d%16;
+            const float x=h<12?q[(size_t(z)*nh+kh*12+h)*256+f+c]:0.f;
+            const auto hi=kv_bf16_encode(x);
+            qhi[d]=__ushort_as_bfloat16(hi);
+            qlo[d]=__ushort_as_bfloat16(kv_bf16_encode(x-kv_bf16_decode(hi)));
+            const int cell=cells[c],page=pages[c];
+            const size_t row=cell>=0?(size_t(page)*nkh+kh)*page_size+cell%page_size:0;
+            keys[d]=__ushort_as_bfloat16(cell>=0?p.k_pool[row*256+f+h]:uint16_t(0));
+            __syncthreads();
+            if(d<32){
+                wmma::fragment<wmma::matrix_a,16,16,16,__nv_bfloat16,wmma::row_major> ah,al;
+                wmma::fragment<wmma::matrix_b,16,16,16,__nv_bfloat16,wmma::row_major> b;
+                wmma::load_matrix_sync(ah,qhi,16);wmma::load_matrix_sync(al,qlo,16);wmma::load_matrix_sync(b,keys,16);
+                wmma::mma_sync(sums,ah,b,sums);wmma::mma_sync(sums,al,b,sums);
+            }
+            __syncthreads();
+        }
+        if(d<32) wmma::store_matrix_sync(scores,sums,16,wmma::mem_row_major);
+        __syncthreads();
+        for(int j=0;j<16 && j0+j<width;++j){
+            const size_t row=(size_t(pages[j])*nkh+kh)*page_size+cells[j]%page_size;
+            const float v=kv_bf16_decode(p.v_pool[row*256+d]);
+            for(int h=0;h<12;++h){
+                const float score=scores[h*16+j]*(1.f/16.f),next=fmaxf(m[h],score);
+                const float alpha=expf(m[h]-next),beta=expf(score-next);
+                acc[h]=acc[h]*alpha+beta*v;l[h]=l[h]*alpha+beta;m[h]=next;
+            }
+        }
+        __syncthreads();
+    }
+    for(int h=0;h<12;++h)out[(size_t(z)*nh+kh*12+h)*256+d]=l[h]>0?acc[h]/l[h]:0.f;
+#else
+    __trap();
+#endif
+}
+}
+void kv_bf16_attention(const float* q, const QsaAttnPools& p, const int32_t* ids,
+                       const int32_t* steps, int64_t cap, const QsaShapes& s,
+                       float* out, int64_t nq, void* stream) {
+    validate(q,p,ids,steps,cap,s,out,nq);
+    static const bool warp=[]() {
+        const char* v=std::getenv("STRATA_BF16_ATTENTION_WARP");
+        if(!v || !std::strcmp(v,"0")) return false;
+        if(!std::strcmp(v,"1")) {std::fprintf(stderr,"BF16 attention: warp scheduling, FP32 Q/softmax/PV, unchanged BF16 K/V\n");return true;}
+        std::fprintf(stderr,"BF16 attention warp option must be 0 or 1; no fallback\n");std::exit(2);
+    }();
+    if(warp) bf16_attention_warp_kernel<<<dim3((unsigned)s.n_head,(unsigned)nq),32,0,(cudaStream_t)stream>>>(
+        q,p,ids,steps,(int)cap,(int)s.n_head,(int)s.n_head_kv,(int)s.page_size,out);
+    else bf16_attention_kernel<<<dim3((unsigned)s.n_head,(unsigned)nq),256,0,(cudaStream_t)stream>>>(
+        q,p,ids,steps,(int)cap,(int)s.n_head,(int)s.n_head_kv,(int)s.page_size,out);
+    const auto e=cudaGetLastError();
+    if(e!=cudaSuccess){std::fprintf(stderr,"BF16 KV attention: %s\n",cudaGetErrorString(e));std::exit(2);}
+}
+void kv_bf16_attention_reference(const float* q, const QsaAttnPools& p, const int32_t* ids,
+                       const int32_t* steps, int64_t cap, const QsaShapes& s,
+                       float* out, int64_t nq, void* stream) {
+    validate(q,p,ids,steps,cap,s,out,nq);
+    bf16_attention_kernel<<<dim3((unsigned)s.n_head,(unsigned)nq),256,0,(cudaStream_t)stream>>>(
+        q,p,ids,steps,(int)cap,(int)s.n_head,(int)s.n_head_kv,(int)s.page_size,out);
+    const auto e=cudaGetLastError();
+    if(e!=cudaSuccess){std::fprintf(stderr,"BF16 reference: %s\n",cudaGetErrorString(e));std::exit(2);}
+}
+void kv_bf16_attention_tc(const float* q, const QsaAttnPools& p, const int32_t* ids,
+                          const int32_t* steps, int64_t cap, const QsaShapes& s,
+                          float* out, int64_t nq, void* stream) {
+    validate(q,p,ids,steps,cap,s,out,nq);
+    int dev=0,major=0;
+    if(s.n_head!=12*s.n_head_kv || cudaGetDevice(&dev)!=cudaSuccess ||
+       cudaDeviceGetAttribute(&major,cudaDevAttrComputeCapabilityMajor,dev)!=cudaSuccess || major<8){
+        std::fprintf(stderr,"BF16 Tensor Core prefill requires sm_80+ and GQA=12; no fallback\n");std::exit(2);
+    }
+    bf16_attention_tc_kernel<<<dim3((unsigned)s.n_head_kv,(unsigned)nq),256,0,(cudaStream_t)stream>>>(
+        q,p,ids,steps,(int)cap,(int)s.n_head_kv,(int)s.page_size,out);
+    const auto e=cudaGetLastError();
+    if(e!=cudaSuccess){std::fprintf(stderr,"BF16 Tensor Core prefill: %s\n",cudaGetErrorString(e));std::exit(2);}
+}
+}
