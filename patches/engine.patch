diff --git a/include/strata/kernels/kv_bf16.hpp b/include/strata/kernels/kv_bf16.hpp
new file mode 100644
index 0000000..894f09a
--- /dev/null
+++ b/include/strata/kernels/kv_bf16.hpp
@@ -0,0 +1,29 @@
+#pragma once
+#include "strata/kernels/qsa_decode_attn.hpp"
+#include <cstdio>
+#include <cstdlib>
+namespace strata::kernels {
+// Correctness-first FP32 attention over BF16 paged storage. No FP16 intermediates.
+// steps/ids are query-major; each query has kStepCount entries and cap IDs.
+#if defined(__HIPCC__)
+inline void kv_bf16_attention(const float*, const QsaAttnPools&, const int32_t*, const int32_t*, int64_t,
+                               const QsaShapes&, float*, int64_t, void*) {
+    std::fprintf(stderr,"BF16 KV prototype requires CUDA; no fallback\n"); std::exit(2);
+}
+#else
+void kv_bf16_attention(const float* q, const QsaAttnPools& pools, const int32_t* ids,
+                       const int32_t* steps, int64_t cap, const QsaShapes& shapes,
+                       float* output, int64_t queries, void* stream);
+#endif
+#if !defined(__HIPCC__)
+// Retained CUDA reference for bit-level scheduling regression.
+void kv_bf16_attention_reference(const float* q, const QsaAttnPools& pools, const int32_t* ids,
+                       const int32_t* steps, int64_t cap, const QsaShapes& shapes,
+                       float* output, int64_t queries, void* stream);
+// Experimental prefill: BF16 Tensor Core QK (Q_hi + Q_lo) with FP32 softmax/PV.
+// CUDA sm_80+, Flash-Next GQA=12, no FP16 intermediates. Explicit opt-in in dispatch.
+void kv_bf16_attention_tc(const float* q, const QsaAttnPools& pools, const int32_t* ids,
+                          const int32_t* steps, int64_t cap, const QsaShapes& shapes,
+                          float* output, int64_t queries, void* stream);
+#endif
+}
diff --git a/include/strata/kernels/kv_dtype.hpp b/include/strata/kernels/kv_dtype.hpp
new file mode 100644
index 0000000..861d63f
--- /dev/null
+++ b/include/strata/kernels/kv_dtype.hpp
@@ -0,0 +1,47 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+namespace strata::kernels {
+// Stable wire IDs: never alias BF16 (4) with FP16 (0), despite equal element sizes.
+enum class KvStorage : uint8_t { Fp16 = 0, Int8 = 1, Q4 = 2, Hybrid = 3, Bf16 = 4 };
+// Startup-only policy. Kernels receive a value in their shapes/pools, not this variable.
+inline KvStorage configured_kv_storage = KvStorage::Fp16;
+inline bool parse_kv_storage(const char* name, KvStorage& out) {
+    if (!name) return false;
+    if (!std::strcmp(name,"fp16")) out=KvStorage::Fp16;
+    else if (!std::strcmp(name,"bf16")) out=KvStorage::Bf16;
+    else if (!std::strcmp(name,"int8")) out=KvStorage::Int8;
+    else if (!std::strcmp(name,"q4_0")) out=KvStorage::Q4;
+    else if (!std::strcmp(name,"k8v4")) out=KvStorage::Hybrid;
+    else return false;
+    return true;
+}
+inline bool valid_kv_storage(KvStorage s) { return static_cast<unsigned>(s) <= 4; }
+inline bool kv_is_16bit(KvStorage s) { return s==KvStorage::Fp16 || s==KvStorage::Bf16; }
+#if defined(__CUDACC__) || defined(__HIPCC__)
+#define STRATA_KV_HD __host__ __device__
+#else
+#define STRATA_KV_HD
+#endif
+// RNE directly from FP32. NaNs remain quiet NaNs, never round to infinity.
+STRATA_KV_HD inline uint16_t kv_bf16_encode(float x) {
+    uint32_t u;
+#if defined(__CUDA_ARCH__) || defined(__HIP_DEVICE_COMPILE__)
+    u=__float_as_uint(x);
+#else
+    std::memcpy(&u,&x,4);
+#endif
+    if ((u & 0x7fffffffU)>0x7f800000U) return uint16_t((u>>16)|0x0040U);
+    return uint16_t((u + 0x7fffU + ((u>>16)&1U))>>16);
+}
+STRATA_KV_HD inline float kv_bf16_decode(uint16_t h) {
+    uint32_t u=uint32_t(h)<<16;
+#if defined(__CUDA_ARCH__) || defined(__HIP_DEVICE_COMPILE__)
+    return __uint_as_float(u);
+#else
+    float f; std::memcpy(&f,&u,4); return f;
+#endif
+}
