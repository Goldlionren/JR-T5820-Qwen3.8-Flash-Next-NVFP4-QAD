+    cudaStream_t stream;ck(cudaStreamCreateWithFlags(&stream,cudaStreamNonBlocking));cudaGraph_t graph;cudaGraphExec_t exec;
+    put(step,std::vector<int32_t>{0,T,T/4,1});
