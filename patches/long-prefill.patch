+// Four independent warps consume the same selected pages and KV head. Each
+// still uses the original 256-product reduction tree and online softmax order.
+bool kv_bf16_grouped_prefill(const float* q, const QsaAttnPools& p, const int32_t* ids,
+                             const int32_t* steps, int64_t cap, const QsaShapes& s,
+                             float* out, int64_t nq, void* stream) {
+    static const bool enabled = [] {
+        const char* value = std::getenv("STRATA_BF16_PREFILL_GROUP_WARPS");
+        return value && !std::strcmp(value, "1");
+    }();
+    constexpr int heads = 4;
+    if (!enabled || s.n_head_kv <= 0 || s.n_head % (heads * s.n_head_kv) != 0) return false;
+    validate(q,p,ids,steps,cap,s,out,nq);
+    const dim3 grid(s.n_head / heads, (unsigned)nq);
+    bf16_attention_warp_kernel<heads><<<grid,32*heads,0,(cudaStream_t)stream>>>(
+        q,p,ids,steps,(int)cap,(int)s.n_head,(int)s.n_head_kv,(int)s.page_size,out);
+    if (const auto e = cudaGetLastError(); e != cudaSuccess) {
+        std::fprintf(stderr, "BF16 grouped prefill: %s\n", cudaGetErrorString(e));
+        std::exit(2);
+    }
+    return true;
+}
